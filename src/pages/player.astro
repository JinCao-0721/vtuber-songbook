---
import { songs } from '../data/songs';
import { profile, siteId } from '../data/site';

const latestSongs = songs.filter((song) => song.vupId === siteId);
const playerTracks = latestSongs.flatMap((song) => song.audio.map((track) => ({ ...track, label: track.label, songTitle: song.title, artist: song.artist, originalArtist: song.originalArtist, accent: song.accent })));
---

<!doctype html>
<html lang="zh-CN">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{profile.name} · 播放器</title></head>
  <body>
    <main class="player-page">
      <header class="player-header"><a class="back-link" href="/">← 返回歌单</a><div class="player-brand"><span class="brand-symbol">✦</span><strong>{profile.name}</strong><small>FULL PLAYER</small></div><span class="header-note">PERSONAL MUSIC ARCHIVE</span></header>
      <section class="player-layout">
        <aside class="player-sidebar"><p class="sidebar-kicker">PLAYBACK</p><h2>播放设置</h2><div class="setting-block"><span>播放内容</span><div class="large-mode"><button class="large-mode-button active" data-mode="original" aria-selected="true">原唱</button><button class="large-mode-button" data-mode="cover" aria-selected="false">翻唱</button></div></div><div class="setting-block quality-setting"><span>默认音质</span><div class="quality-picker quality-mode" data-quality-picker><select data-quality-preference aria-label="默认音质" hidden><option value="high">高音质优先</option><option value="low">低音质优先</option></select><div class="large-mode"><button type="button" class="large-mode-button active" data-quality-option="high">高音质优先</button><button type="button" class="large-mode-button" data-quality-option="low">低音质优先</button></div></div></div><div class="sidebar-rule"></div><p class="sidebar-kicker">SHORTCUTS</p><p class="sidebar-copy">原唱模式会按每首歌曲选择一个可用音质；翻唱模式会顺序播放所有翻唱。</p><a class="sidebar-home" href="/#playlist">查看全部歌曲 ↗</a></aside>
        <section class="player-stage"><div class="stage-kicker">NOW PLAYING <span data-global-format>MP3</span></div><div class="stage-cover" data-cover><span>♪</span><i></i></div><h1 data-global-title>选择一首歌开始播放</h1><p data-global-artist>{profile.name} · 原唱</p><div class="stage-progress"><span data-current-time>0:00</span><input type="range" min="0" max="100" value="0" step="0.1" data-seek aria-label="播放进度" /><span data-total-time>0:00</span></div><div class="stage-controls"><div class="stage-main-buttons"><button type="button" data-global-prev aria-label="上一首"><svg class="media-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m19 20-9-8 9-8v16Z"/><path d="M5 19V5"/></svg></button><button class="stage-play" type="button" data-play-toggle aria-label="播放"><span data-play-icon><svg class="media-icon play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 9 6-9 6V6Z"/></svg><svg class="media-icon pause-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg></span></button><button type="button" data-global-next aria-label="下一首"><svg class="media-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 4 9 8-9 8V4Z"/><path d="M19 5v14"/></svg></button></div><label class="stage-loop" title="循环当前"><input type="checkbox" data-global-loop /><span><svg class="media-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m17 2 4 4-4 4"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="m7 22-4-4 4-4"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/></svg></span></label></div><p class="stage-status" data-stage-status>READY TO PLAY</p></section>
        <aside class="queue-panel"><div class="queue-heading"><div><p class="sidebar-kicker">UP NEXT</p><h2>播放列表</h2></div><span data-global-position>01 / {String(playerTracks.length).padStart(2, '0')}</span></div><div class="queue-list" data-queue-list></div></aside>
      </section>
      <script type="application/json" data-global-tracks set:html={JSON.stringify(playerTracks)}></script>
    </main>
    <script>
      import { Howl } from 'howler';
      const page = document.querySelector('.player-page');
      const tracks = JSON.parse(page.querySelector('[data-global-tracks]').textContent); const selectQuality = page.querySelector('[data-quality-preference]'); const qualityOptions = page.querySelectorAll('[data-quality-option]'); const title = page.querySelector('[data-global-title]'); const artist = page.querySelector('[data-global-artist]'); const format = page.querySelector('[data-global-format]'); const position = page.querySelector('[data-global-position]'); const cover = page.querySelector('[data-cover]'); const seek = page.querySelector('[data-seek]'); const current = page.querySelector('[data-current-time]'); const total = page.querySelector('[data-total-time]'); const playButton = page.querySelector('[data-play-toggle]'); const status = page.querySelector('[data-stage-status]'); const list = page.querySelector('[data-queue-list]'); const modeButtons = page.querySelectorAll('[data-mode]');
      let mode = 'original'; let preference = 'high'; let queue = []; let index = 0; let howl; let raf; let activeTitle = '';
      const time = (seconds) => { if (!Number.isFinite(seconds)) return '0:00'; const m = Math.floor(seconds / 60); const s = Math.floor(seconds % 60).toString().padStart(2, '0'); return `${m}:${s}`; };
      const buildQueue = (preferredTitle = activeTitle, exactSrc = '') => { if (mode === 'cover') queue = tracks.filter((track) => !track.quality); else { const originals = tracks.filter((track) => Boolean(track.quality)); const titles = [...new Set(originals.map((track) => track.songTitle))]; const order = preference === 'high' ? ['FLAC', '320K', '128K'] : ['128K', '320K', 'FLAC']; queue = titles.map((songTitle) => { const options = originals.filter((track) => track.songTitle === songTitle); if (songTitle === preferredTitle && exactSrc) { const exact = options.find((track) => track.src === exactSrc); if (exact) return exact; } return order.map((quality) => options.find((track) => track.quality === quality)).find(Boolean) || options[0]; }).filter(Boolean); } index = Math.max(0, queue.findIndex((track) => track.songTitle === preferredTitle)); if (index < 0) index = 0; renderQueue(); };
      const renderQueue = () => { list.innerHTML = queue.map((track, i) => `<button type="button" class="queue-item${i === index ? ' active' : ''}" data-queue-index="${i}"><span class="queue-number">${String(i + 1).padStart(2, '0')}</span><span class="queue-song"><b>${track.songTitle}</b><small>${track.label}${track.quality ? ` · ${track.quality}` : ''}</small></span><span class="queue-duration">${i === index ? 'PLAYING' : '›'}</span></button>`).join(''); list.querySelectorAll('[data-queue-index]').forEach((button) => button.addEventListener('click', () => load(Number(button.dataset.queueIndex), true))); };
      const update = () => { if (!howl) return; const duration = howl.duration() || 0; const value = howl.seek() || 0; seek.value = duration ? String((value / duration) * 100) : '0'; current.textContent = time(value); total.textContent = time(duration); if (howl.playing()) raf = requestAnimationFrame(update); };
      const setPlaying = (playing) => { playButton.setAttribute('aria-label', playing ? '暂停' : '播放'); page.classList.toggle('is-playing', playing); status.textContent = playing ? 'PLAYING' : 'READY TO PLAY'; if (playing) update(); else cancelAnimationFrame(raf); };
      const persist = () => { try { localStorage.setItem('songbook:player', JSON.stringify({ mode, preference, src: queue[index]?.src, playing: Boolean(howl?.playing()) })); } catch {} };
      const load = (nextIndex, autoplay = false) => { const track = queue[nextIndex]; if (!track) return; if (howl) howl.unload(); index = nextIndex; activeTitle = track.songTitle; title.textContent = `${track.songTitle} · ${track.label}`; artist.textContent = mode === 'cover' ? `${track.artist || profile.name} · 翻唱` : `${track.originalArtist || '原唱歌手'} · 原唱`; format.textContent = track.quality || 'MP3'; cover.style.background = `linear-gradient(135deg, ${track.accent || '#dc86b1'}, #30273b)`; position.textContent = `${String(index + 1).padStart(2, '0')} / ${String(queue.length).padStart(2, '0')}`; current.textContent = '0:00'; total.textContent = '0:00'; renderQueue(); howl = new Howl({ src: [track.src], html5: true, onload: () => { total.textContent = time(howl.duration()); }, onplay: () => { setPlaying(true); persist(); }, onpause: () => { setPlaying(false); persist(); }, onstop: () => setPlaying(false), onend: () => { if (page.querySelector('[data-global-loop]').checked) howl.play(); else load((index + 1) % queue.length, true); }, onloaderror: () => { status.textContent = 'AUDIO UNAVAILABLE'; setPlaying(false); } }); if (autoplay) howl.play(); persist(); };
      const rebuild = (autoplay = false, exactSrc = '') => { const wasPlaying = Boolean(howl?.playing()); if (howl) howl.unload(); buildQueue(activeTitle, exactSrc); if (queue.length) load(index, autoplay || wasPlaying); };
      const setMode = (nextMode) => { mode = nextMode; modeButtons.forEach((button) => { const active = button.dataset.mode === mode; button.classList.toggle('active', active); button.setAttribute('aria-selected', String(active)); }); rebuild(Boolean(howl?.playing())); };
      modeButtons.forEach((button) => button.addEventListener('click', () => setMode(button.dataset.mode))); const syncQuality = () => { qualityOptions.forEach((option) => option.classList.toggle('active', option.dataset.qualityOption === selectQuality.value)); }; qualityOptions.forEach((option) => option.addEventListener('click', () => { selectQuality.value = option.dataset.qualityOption; preference = selectQuality.value; syncQuality(); if (mode === 'original') rebuild(Boolean(howl?.playing())); })); playButton.addEventListener('click', () => { if (!howl) return load(index, true); howl.playing() ? howl.pause() : howl.play(); }); page.querySelector('[data-global-prev]').addEventListener('click', () => load((index - 1 + queue.length) % queue.length, true)); page.querySelector('[data-global-next]').addEventListener('click', () => load((index + 1) % queue.length, true)); page.querySelector('[data-global-loop]').addEventListener('change', (event) => { if (howl) howl.loop(event.target.checked); }); seek.addEventListener('input', () => { if (howl && howl.duration()) howl.seek((Number(seek.value) / 100) * howl.duration()); });
      try { const saved = JSON.parse(localStorage.getItem('songbook:player') || '{}'); mode = saved.mode || mode; preference = saved.preference || preference; selectQuality.value = preference; } catch {}
      syncQuality();
      modeButtons.forEach((button) => { const active = button.dataset.mode === mode; button.classList.toggle('active', active); button.setAttribute('aria-selected', String(active)); }); buildQueue(); let initialIndex = 0; try { const saved = JSON.parse(localStorage.getItem('songbook:player') || '{}'); initialIndex = queue.findIndex((track) => track.src === saved.src); } catch {} load(initialIndex >= 0 ? initialIndex : 0);
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing:border-box; }
  :global(body) { margin:0; color:#f8f1fb; background:#201a28; font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  :global(button),:global(select),:global(input) { font:inherit; }
  .player-page { min-height:100vh; padding:0 42px 50px; background:radial-gradient(circle at 70% 20%,#4e345c 0,#201a28 43%),#201a28; }
  .player-header { display:flex; align-items:center; justify-content:space-between; height:78px; max-width:1280px; margin:auto; border-bottom:1px solid #ffffff15; }.back-link,.header-note { color:#bcaac5; font-size:.68rem; }.back-link:hover{color:#fff}.player-brand{display:flex;align-items:center;gap:.6rem}.player-brand strong{font-size:.85rem;letter-spacing:.14em}.player-brand small{color:#bcaac5;font-size:.55rem;letter-spacing:.16em}.brand-symbol{display:grid;place-items:center;width:26px;height:26px;border-radius:8px;background:#e598bc;color:#36263e}.player-layout{display:grid;grid-template-columns:220px minmax(360px,1fr) 300px;gap:52px;max-width:1280px;margin:0 auto;padding-top:70px}.sidebar-kicker,.stage-kicker{margin:0 0 .8rem;color:#e39abb;font-size:.57rem;font-weight:800;letter-spacing:.18em}.player-sidebar h2,.queue-heading h2{margin:0;color:#fff;font-family:Georgia,serif;font-size:1.65rem;font-weight:500}.setting-block{display:grid;gap:.55rem;margin-top:2rem;color:#bcaac5;font-size:.7rem}.large-mode{display:grid;gap:.35rem}.large-mode-button{padding:.65rem .75rem;border:1px solid #ffffff18;border-radius:8px;text-align:left;color:#bcaac5;background:#ffffff08;cursor:pointer;font-size:.74rem}.large-mode-button.active{border-color:#e598bc;color:#2e2037;background:#e598bc;font-weight:800}.quality-setting select{appearance:none;-webkit-appearance:none;width:100%;padding:.55rem .6rem;border:1px solid #ffffff22;border-radius:7px;color:#f8f1fb;background:transparent;outline:0;font-size:.7rem}.sidebar-rule{height:1px;margin:2.3rem 0 1.5rem;background:#ffffff15}.sidebar-copy{color:#98879f;font-size:.68rem;line-height:1.8}.sidebar-home{display:inline-block;margin-top:1.2rem;color:#e39abb;font-size:.68rem}.player-stage{text-align:center;padding:0 1rem}.stage-kicker{display:flex;justify-content:center;gap:.6rem}.stage-kicker span{padding:.18rem .38rem;border:1px solid #ffffff28;border-radius:4px;color:#f1bed4;font-size:.5rem}.stage-cover{position:relative;display:grid;place-items:center;width:min(330px,70vw);aspect-ratio:1;margin:26px auto 28px;border-radius:12px;color:#fff;background:linear-gradient(135deg,#dc86b1,#30273b);box-shadow:0 28px 70px #09070d80;font:6rem Georgia,serif}.stage-cover::before,.stage-cover::after{content:'';position:absolute;inset:8%;border:1px solid #ffffff36;border-radius:50%;transform:rotate(-25deg) scaleY(.48)}.stage-cover::after{inset:18%;transform:rotate(58deg) scaleY(.48);border-color:#ffffff22}.stage-cover i{position:absolute;width:25%;aspect-ratio:1;right:9%;bottom:8%;border-radius:50%;background:#ffffff1a}.player-stage h1{margin:0;color:#fff;font-family:Georgia,serif;font-size:1.8rem;font-weight:500;letter-spacing:-.04em}.player-stage>p{margin:.55rem 0 1.5rem;color:#a996b1;font-size:.75rem}.stage-progress{display:flex;align-items:center;gap:.6rem;color:#a996b1;font-size:.6rem}.stage-progress input{width:100%;accent-color:#e598bc}.stage-controls{position:relative;display:flex;justify-content:center;align-items:center;text-align:center;margin-top:1.2rem}.stage-main-buttons{display:flex;justify-content:center;align-items:center;gap:1rem}.stage-controls .stage-loop{position:absolute;right:calc(50% - 150px)}.stage-main-buttons>button{display:grid;place-items:center;width:2.3rem;height:2.3rem;border:1px solid #ffffff22;border-radius:50%;color:#fff;background:#ffffff08;cursor:pointer;font-size:1.3rem}.stage-main-buttons .stage-play{display:grid;place-items:center;width:3.1rem;height:3.1rem;border:0;color:#2f2138;background:#e598bc;font-size:.9rem}.stage-loop{display:grid;place-items:center;width:2.3rem;height:2.3rem;border:1px solid #ffffff22;border-radius:50%;color:#bcaac5;cursor:pointer}.stage-loop input{position:absolute;opacity:0}.stage-loop:has(input:checked){border-color:#e598bc;color:#e598bc;background:#e598bc18}.stage-status{margin-top:1rem;color:#8e7c97;font-size:.56rem;letter-spacing:.16em}.queue-panel{min-width:0}.queue-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:1rem}.queue-heading>span{color:#a996b1;font-size:.6rem;letter-spacing:.1em}.queue-list{display:grid;gap:.25rem;max-height:480px;overflow:auto;padding-right:.35rem}.queue-list{background:transparent}.queue-item{display:grid;grid-template-columns:26px 1fr auto;align-items:center;gap:.5rem;width:100%;padding:.65rem .55rem;border:1px solid transparent;border-radius:8px;text-align:left;color:#d7cadc;background:rgba(255,255,255,.025);cursor:pointer}.queue-item,.queue-item *{color:#d7cadc !important}.queue-item{appearance:none !important;background:transparent !important}.queue-item:hover{background:rgba(255,255,255,.08) !important;border-color:#ffffff14}.queue-item.active,.queue-item.active *{color:#fff !important}.queue-item.active{background:rgba(229,152,188,.12) !important}.queue-item.active{border-color:#e598bc33;background:#e598bc12;color:#fff}.queue-number{color:#8c7b95;font-size:.58rem}.queue-item.active .queue-number{color:#e598bc}.queue-song{display:grid;gap:.25rem;min-width:0}.queue-song b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.7rem;font-weight:600}.queue-song small{overflow:hidden;color:#a898b0;text-overflow:ellipsis;white-space:nowrap;font-size:.59rem}.queue-duration{color:#8e7c97;font-size:.54rem;letter-spacing:.08em}.queue-item.active .queue-duration{color:#e598bc}
  :global(.quality-setting select option), :global(.quality-preference select option) { color:#f8f1fb !important; background:#272033 !important; }
  :global(.queue-item) { appearance:none !important; display:grid !important; grid-template-columns:26px 1fr auto !important; align-items:center !important; gap:.5rem !important; width:100% !important; padding:.65rem .55rem !important; border:1px solid transparent !important; border-radius:8px !important; text-align:left !important; color:#d7cadc !important; background:transparent !important; cursor:pointer !important; }.queue-item:hover { background:rgba(255,255,255,.08) !important; border-color:#ffffff14 !important; }.queue-item.active { color:#fff !important; background:rgba(229,152,188,.12) !important; border-color:#e598bc33 !important; }.queue-item * { color:inherit !important; }.queue-item .queue-number { color:#8c7b95 !important; }.queue-item.active .queue-number,.queue-item.active .queue-duration { color:#e598bc !important; }.queue-item .queue-song { display:grid !important; gap:.25rem !important; min-width:0 !important; }.queue-item .queue-song b { overflow:hidden !important; color:inherit !important; text-overflow:ellipsis !important; white-space:nowrap !important; font-size:.7rem !important; font-weight:600 !important; }.queue-item .queue-song small { overflow:hidden !important; color:#a898b0 !important; text-overflow:ellipsis !important; white-space:nowrap !important; font-size:.59rem !important; }.queue-item .queue-duration { color:#8e7c97 !important; font-size:.54rem !important; letter-spacing:.08em !important; }
  .stage-play .media-icon { width:22px; height:22px; }
  .media-icon { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; display:block; }.play-icon { fill:currentColor; stroke:none; }.pause-icon { display:none; }.is-playing .play-icon { display:none; }.is-playing .pause-icon { display:block; }
  @media(max-width:900px){.player-page{padding:0 20px 35px}.header-note{display:none}.player-layout{grid-template-columns:1fr;gap:40px;padding-top:40px}.player-sidebar{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.player-sidebar h2,.sidebar-rule,.sidebar-copy,.sidebar-home,.sidebar-kicker:nth-of-type(2){display:none}.setting-block{margin-top:0}.stage-cover{width:min(300px,74vw)}.stage-controls .stage-loop{position:static;margin-left:.35rem}.queue-panel{max-width:620px;width:100%;margin:auto}.queue-list{max-height:none}}
</style>
