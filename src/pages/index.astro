---
import { songs } from '../data/songs';
import { profile, siteId } from '../data/site';

const latestSongs = songs.filter((song) => song.vupId === siteId);
const playerTracks = latestSongs.flatMap((song) => song.audio.map((track) => ({ ...track, label: track.label === 'VTuber 翻唱' ? `${profile.name} 翻唱` : track.label, songTitle: song.title, artist: song.artist, originalArtist: song.originalArtist, accent: song.accent })));
const categories = ['\u5168\u90e8', '\u56fd\u8bed', '\u65e5\u8bed', '\u6d41\u884c', ...new Set(latestSongs.flatMap((song) => song.categories ?? []))].filter((category, index, list) => list.indexOf(category) === index);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{profile.name} · Songbook</title>
    <meta name="description" content={`${profile.name} 的 VTuber 歌单档案`} />
  </head>
  <body>
    <main class="site-shell">
      <nav class="topbar">
        <a class="brand" href="/" aria-label={`${profile.name} 歌单首页`}><span class="brand-symbol">✦</span><span class="brand-name">{profile.name}<small>SONGBOOK</small></span></a>
      </nav>

      <section class="search-panel" id="about">
        <div class="search-heading"><div><p class="kicker">SONGBOOK SEARCH</p><h1>搜索歌单</h1><p>按歌名、歌手或原唱查找歌曲，也可以按分类浏览。</p></div><span class="search-total">{String(latestSongs.length).padStart(2, '0')} SONGS</span></div>
        <label class="song-search"><svg class="media-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg><input type="search" data-song-search placeholder="搜索歌名、歌手或原唱" aria-label="搜索歌曲" /></label>
      </section>

      <section class="player-dock qq-player" data-global-player aria-label="音乐播放器">
        <div class="qq-player-main">
          <div class="qq-current"><div class="qq-cover" data-cover aria-hidden="true"><span>♪</span></div><div class="qq-track-info"><span class="dock-kicker">NOW PLAYING</span><strong data-global-title>选择一首歌开始播放</strong><small data-global-artist>{profile.name} · 原唱</small></div></div>
          <div class="qq-transport"><div class="qq-buttons"><button class="icon-button" type="button" data-global-prev aria-label="上一首"><svg class="media-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m19 20-9-8 9-8v16Z"/><path d="M5 19V5"/></svg></button><button class="play-button" type="button" data-play-toggle aria-label="播放"><span data-play-icon><svg class="media-icon play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 9 6-9 6V6Z"/></svg><svg class="media-icon pause-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg></span></button><button class="icon-button" type="button" data-global-next aria-label="下一首"><svg class="media-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 4 9 8-9 8V4Z"/><path d="M19 5v14"/></svg></button></div><div class="dock-progress"><span data-current-time>0:00</span><input type="range" min="0" max="100" value="0" step="0.1" data-seek aria-label="播放进度" /><span data-total-time>0:00</span></div></div>
          <div class="qq-tools"><span class="quality-badge" data-global-format>MP3</span><em data-global-position>01 / {String(playerTracks.length).padStart(2, '0')}</em><label class="loop-toggle" title="循环当前"><input type="checkbox" data-global-loop /><span><svg class="media-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m17 2 4 4-4 4"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="m7 22-4-4 4-4"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/></svg></span></label><button class="queue-button" type="button" data-track-toggle aria-expanded="false" aria-label="打开播放列表"><svg class="media-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><path d="M3 6h.01M3 12h.01M3 18h.01"/></svg></button><button class="player-open-link" type="button" data-full-toggle aria-expanded="false" aria-label="展开播放器">展开 ↗</button></div>
        </div>
        <div class="qq-extra" data-player-extra><div class="qq-extra-group"><span class="qq-extra-label">播放模式</span><div class="mode-switch" role="tablist" aria-label="播放模式"><button type="button" class="mode-button active" data-mode="original" aria-selected="true">原唱</button><button type="button" class="mode-button" data-mode="cover" aria-selected="false">翻唱</button></div></div><div class="quality-preference" data-quality-picker><span>默认音质</span><select data-quality-preference aria-label="默认音质" hidden><option value="high">高音质优先</option><option value="low">低音质优先</option></select><button type="button" class="quality-trigger" data-quality-trigger><span data-quality-label>高音质优先</span><span class="quality-chevron">⌄</span></button><div class="quality-menu" data-quality-menu hidden><button type="button" data-quality-option="high">高音质优先</button><button type="button" data-quality-option="low">低音质优先</button></div></div><div class="qq-queue"><label for="track-select">播放列表</label><select id="track-select" aria-label="选择歌曲" data-global-select></select></div></div>
        <div class="inline-full" data-inline-full hidden><header class="inline-header"><span>FULL PLAYER</span><button type="button" data-full-close aria-label="收起播放器">收起播放器 ×</button></header><div class="inline-layout"><aside class="inline-sidebar"><p class="inline-kicker">PLAYBACK</p><h2>播放设置</h2><div class="inline-setting"><span>播放内容</span><div class="inline-mode-list"><button type="button" class="large-mode-button active" data-mode="original">原唱</button><button type="button" class="large-mode-button" data-mode="cover">翻唱</button></div></div><div class="inline-setting"><span>默认音质</span><div class="inline-quality-list"><button type="button" class="large-mode-button active" data-quality-option="high">高音质优先</button><button type="button" class="large-mode-button" data-quality-option="low">低音质优先</button></div></div></aside><section class="inline-stage"><span class="inline-kicker">NOW PLAYING <b data-inline-format>MP3</b></span><div class="inline-cover" data-inline-cover><span>♪</span></div><h1 data-inline-title>选择一首歌开始播放</h1><p data-inline-artist>{profile.name} · 原唱</p><div class="inline-progress"><span data-inline-current>0:00</span><input type="range" min="0" max="100" value="0" step="0.1" data-inline-seek aria-label="播放进度" /><span data-inline-total>0:00</span></div><div class="inline-controls"><button type="button" data-inline-prev aria-label="上一首"><svg class="media-icon" viewBox="0 0 24 24"><path d="m19 20-9-8 9-8v16Z"/><path d="M5 19V5"/></svg></button><button type="button" class="inline-play" data-inline-play aria-label="播放"><span data-inline-play-icon><svg class="media-icon play-icon" viewBox="0 0 24 24"><path d="m9 6 9 6-9 6V6Z"/></svg><svg class="media-icon pause-icon" viewBox="0 0 24 24"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg></span></button><button type="button" data-inline-next aria-label="下一首"><svg class="media-icon" viewBox="0 0 24 24"><path d="m5 4 9 8-9 8V4Z"/><path d="M19 5v14"/></svg></button><label class="inline-loop"><input type="checkbox" data-inline-loop /><span><svg class="media-icon" viewBox="0 0 24 24"><path d="m17 2 4 4-4 4"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="m7 22-4-4 4-4"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/></svg></span></label></div></section><aside class="inline-queue"><p class="inline-kicker">UP NEXT</p><h2>播放列表</h2><div data-inline-queue></div></aside></div></div>
        <script type="application/json" data-global-tracks set:html={JSON.stringify(playerTracks)}></script>
      </section>

      <section class="playlist" id="playlist"><div class="section-heading"><div><p class="kicker">THE COLLECTION</p><h2>歌单</h2></div><span class="collection-count">{String(latestSongs.length).padStart(2, '0')} SONGS</span></div><div class="filter-row" data-filter-bar>{categories.map((category, index) => <button class={`filter${index === 0 ? ' active' : ''}`} type="button" data-category={category}>{category} <b>{category === '\u5168\u90e8' ? latestSongs.length : latestSongs.filter((song) => (song.categories ?? []).includes(category)).length}</b></button>)}</div><div class="song-grid">{latestSongs.map((song, index) => <article class="song-card" data-type={song.type} data-search={`${song.title} ${song.artist} ${song.originalArtist ?? ''}`.toLowerCase()} data-categories={(song.categories ?? []).join('|')} style={`--accent:${song.accent};--delay:${index * 80}ms`}><div class="row-index">{String(index + 1).padStart(2, '0')}</div><div class="card-content"><div class="song-row"><span class="row-type">{song.type}</span><span class="row-duration">{song.duration}</span><h3>{song.title}</h3><span class="row-artist">{song.artist}{song.originalArtist && <small>原唱 {song.originalArtist}</small>}</span><div class="card-links">{song.links.bilibili && <a href={song.links.bilibili} target="_blank" rel="noreferrer">BILIBILI ↗</a>}{song.links.qq && <a href={song.links.qq} target="_blank" rel="noreferrer">QQ MUSIC ↗</a>}</div></div></div></article>)}</div></section>

      <footer><span>{profile.name} / SONGBOOK</span><span>MADE BY 拉拉肥</span></footer>
    </main>

    <script>
      import { Howl } from 'howler';
      const filters = document.querySelectorAll('[data-filter]');
      const cards = document.querySelectorAll('.song-card');
      const categoryButtons = document.querySelectorAll('[data-category]');
      const searchInput = document.querySelector('[data-song-search]');
      let activeCategory = '全部';
      let searchTerm = '';
      const applySongFilters = () => { cards.forEach((card) => { const categoryMatch = activeCategory === '全部' || (card.dataset.categories || '').split('|').includes(activeCategory); const searchMatch = !searchTerm || (card.dataset.search || '').includes(searchTerm); card.hidden = !(categoryMatch && searchMatch); }); };
      categoryButtons.forEach((button) => button.addEventListener('click', () => { categoryButtons.forEach((item) => item.classList.toggle('active', item === button)); activeCategory = button.dataset.category || '全部'; applySongFilters(); }));
      searchInput?.addEventListener('input', (event) => { searchTerm = event.target.value.trim().toLowerCase(); applySongFilters(); });
      filters.forEach((filter) => filter.addEventListener('click', () => { filters.forEach((item) => item.classList.toggle('active', item === filter)); const value = filter.dataset.filter; cards.forEach((card) => { card.hidden = value !== '全部' && card.dataset.type !== value; }); }));
      const root = document.querySelector('[data-global-player]');
      if (root) {
        const allTracks = JSON.parse(root.querySelector('[data-global-tracks]').textContent);
        const fullToggle = root.querySelector('[data-full-toggle]'); const inlineFull = root.querySelector('[data-inline-full]'); const inlineTitle = root.querySelector('[data-inline-title]'); const inlineArtist = root.querySelector('[data-inline-artist]'); const inlineFormat = root.querySelector('[data-inline-format]'); const inlineCover = root.querySelector('[data-inline-cover]'); const inlinePosition = root.querySelector('[data-global-position]'); const inlineQueue = root.querySelector('[data-inline-queue]'); const inlineSeek = root.querySelector('[data-inline-seek]'); const inlineCurrent = root.querySelector('[data-inline-current]'); const inlineTotal = root.querySelector('[data-inline-total]'); const inlinePlay = root.querySelector('[data-inline-play]'); const inlinePrev = root.querySelector('[data-inline-prev]'); const inlineNext = root.querySelector('[data-inline-next]'); const inlineLoop = root.querySelector('[data-inline-loop]'); const select = root.querySelector('[data-global-select]'); const title = root.querySelector('[data-global-title]'); const artist = root.querySelector('[data-global-artist]'); const cover = root.querySelector('[data-cover]'); const format = root.querySelector('[data-global-format]'); const position = root.querySelector('[data-global-position]'); const seek = root.querySelector('[data-seek]'); const current = root.querySelector('[data-current-time]'); const total = root.querySelector('[data-total-time]'); const playButton = root.querySelector('[data-play-toggle]'); const qualitySelect = root.querySelector('[data-quality-preference]'); const qualityTrigger = root.querySelector('[data-quality-trigger]'); const qualityLabels = root.querySelectorAll('[data-quality-label]'); const qualityMenu = root.querySelector('[data-quality-menu]'); const qualityOptions = root.querySelectorAll('[data-quality-option]'); const modeButtons = root.querySelectorAll('[data-mode]');
        let mode = 'original'; let preference = qualitySelect.value; let queue = []; let index = 0; let howl; let raf; let ticker; let activeTitle = ''; let activeSrc = ''; const persist = () => { try { localStorage.setItem('songbook:player', JSON.stringify({ mode, preference, src: queue[index]?.src, playing: Boolean(howl?.playing()) })); } catch {} };
        const time = (seconds) => { if (!Number.isFinite(seconds)) return '0:00'; const m = Math.floor(seconds / 60); const s = Math.floor(seconds % 60).toString().padStart(2, '0'); return `${m}:${s}`; };
        const qualityOrder = () => preference === 'high' ? ['FLAC', '320K', '128K'] : ['128K', '320K', 'FLAC'];
        const renderInlineQueue = () => { if (!inlineQueue) return; inlineQueue.innerHTML = queue.map((track, i) => `<button type="button" class="inline-queue-item${i === index ? ' active' : ''}" style="display:grid;grid-template-columns:25px 1fr;gap:.2rem .5rem;width:100%;padding:.55rem .45rem;border:1px solid ${i === index ? '#e598bc33' : 'transparent'};border-radius:7px;text-align:left;color:${i === index ? '#fff' : '#d7cadc'};background:${i === index ? 'rgba(229,152,188,.14)' : 'transparent'};appearance:none;cursor:pointer" data-inline-index="${i}"><span style="grid-row:span 2;color:${i === index ? '#e598bc' : '#8c7b95'};font-size:.56rem">${String(i + 1).padStart(2, '0')}</span><b style="overflow:hidden;color:inherit;text-overflow:ellipsis;white-space:nowrap;font-size:.67rem;font-weight:600">${track.songTitle}</b><small style="overflow:hidden;color:#a898b0;text-overflow:ellipsis;white-space:nowrap;font-size:.56rem">${track.label}${track.quality ? ` · ${track.quality}` : ''}</small></button>`).join(''); inlineQueue.querySelectorAll('[data-inline-index]').forEach((button) => button.addEventListener('click', () => load(Number(button.dataset.inlineIndex), true))); };
        const buildQueue = (preferredTitle = activeTitle, exactSrc = '') => { if (mode === 'cover') queue = allTracks.filter((track) => !track.quality); else { const originals = allTracks.filter((track) => Boolean(track.quality)); const titles = [...new Set(originals.map((track) => track.songTitle))]; const order = qualityOrder(); queue = titles.map((songTitle) => { const options = originals.filter((track) => track.songTitle === songTitle); if (songTitle === preferredTitle && exactSrc) { const exact = options.find((track) => track.src === exactSrc); if (exact) return exact; } return order.map((quality) => options.find((track) => track.quality === quality)).find(Boolean) || options[0]; }).filter(Boolean); } select.innerHTML = queue.map((track, i) => `<option value="${i}">${track.songTitle} · ${track.label}${track.quality ? ` (${track.quality})` : ''}</option>`).join(''); index = Math.max(0, queue.findIndex((track) => track.songTitle === preferredTitle)); if (index < 0) index = 0; renderInlineQueue(); };
        const update = () => { if (!howl) return; const duration = howl.duration() || 0; const value = howl.seek() || 0; seek.value = duration ? String((value / duration) * 100) : '0'; current.textContent = time(value); total.textContent = time(duration); if (inlineSeek) inlineSeek.value = seek.value; if (inlineCurrent) inlineCurrent.textContent = current.textContent; if (inlineTotal) inlineTotal.textContent = total.textContent;  };
        const setPlaying = (playing) => { playButton.setAttribute('aria-label', playing ? '暂停' : '播放'); if (inlinePlay) inlinePlay.setAttribute('aria-label', playing ? '暂停' : '播放'); root.classList.toggle('is-playing', playing); clearInterval(ticker); ticker = undefined; update(); if (playing) ticker = window.setInterval(update, 200); };
        const load = (nextIndex, autoplay = false) => { const track = queue[nextIndex]; if (!track) return; if (howl) howl.unload(); index = nextIndex; activeTitle = track.songTitle; activeSrc = track.src; renderInlineQueue(); select.value = String(index); title.textContent = `${track.songTitle} · ${track.label}`; if (inlineTitle) inlineTitle.textContent = title.textContent; artist.textContent = mode === 'cover' ? `${track.artist || profile.name} · 翻唱` : `${track.originalArtist || '原唱歌手'} · 原唱`; if (inlineArtist) inlineArtist.textContent = artist.textContent; cover.style.background = `linear-gradient(135deg, ${track.accent || '#dc86b1'}, #30273b)`; if (inlineCover) inlineCover.style.background = cover.style.background; format.textContent = track.quality || 'MP3'; if (inlineFormat) inlineFormat.textContent = format.textContent; position.textContent = `${String(index + 1).padStart(2, '0')} / ${String(queue.length).padStart(2, '0')}`; if (inlinePosition) inlinePosition.textContent = position.textContent; current.textContent = '0:00'; total.textContent = '0:00'; howl = new Howl({ src: [track.src], html5: true, onload: () => { total.textContent = time(howl.duration()); }, onplay: () => setPlaying(true), onpause: () => setPlaying(false), onstop: () => setPlaying(false), onend: () => { if (root.querySelector('[data-global-loop]').checked) howl.play(); else load((index + 1) % queue.length, true); }, onloaderror: () => { artist.textContent = '音频暂时不可用'; setPlaying(false); } }); if (autoplay) howl.play(); persist(); };
        const rebuild = (autoplay = false, exactSrc = '') => { const wasPlaying = Boolean(howl && howl.playing()); if (howl) howl.unload(); buildQueue(activeTitle, exactSrc); if (queue.length) load(index, autoplay || wasPlaying); };
        const setMode = (nextMode, exactTrack = null) => { mode = nextMode; modeButtons.forEach((button) => { const active = button.dataset.mode === mode; button.classList.toggle('active', active); button.setAttribute('aria-selected', String(active)); }); activeTitle = exactTrack?.songTitle || activeTitle; rebuild(Boolean(howl && howl.playing()), exactTrack?.src || ''); };
        modeButtons.forEach((button) => button.addEventListener('click', () => { setMode(button.dataset.mode); persist(); }));
        const qualityNames = { high: '高音质优先', low: '低音质优先' }; const syncQuality = () => { qualityLabels.forEach((label) => { label.textContent = qualityNames[qualitySelect.value]; }); qualityOptions.forEach((option) => option.classList.toggle('active', option.dataset.qualityOption === qualitySelect.value)); }; qualityTrigger.addEventListener('click', () => { qualityMenu.hidden = !qualityMenu.hidden; }); qualityOptions.forEach((option) => option.addEventListener('click', () => { qualitySelect.value = option.dataset.qualityOption; preference = qualitySelect.value; syncQuality(); qualityMenu.hidden = true; if (mode === 'original') rebuild(Boolean(howl && howl.playing())); persist(); })); document.addEventListener('click', (event) => { if (!event.target.closest('[data-quality-picker]')) qualityMenu.hidden = true; }); syncQuality();
        playButton.addEventListener('click', () => { if (!howl) return load(index, true); if (howl.playing()) howl.pause(); else { howl.play(); setPlaying(true); } }); select.addEventListener('change', () => load(Number(select.value), true)); root.querySelector('[data-global-prev]').addEventListener('click', () => load((index - 1 + queue.length) % queue.length, true)); root.querySelector('[data-global-next]').addEventListener('click', () => load((index + 1) % queue.length, true)); root.querySelector('[data-global-loop]').addEventListener('change', (event) => { if (howl) howl.loop(event.target.checked); }); seek.addEventListener('input', () => { if (howl && howl.duration()) { howl.seek((Number(seek.value) / 100) * howl.duration()); update(); } }); root.querySelector('[data-track-toggle]').addEventListener('click', (event) => { const expanded = root.classList.toggle('is-expanded'); event.currentTarget.setAttribute('aria-expanded', String(expanded)); }); fullToggle.addEventListener('click', () => { const expanded = root.classList.toggle('is-full'); fullToggle.setAttribute('aria-expanded', String(expanded)); fullToggle.textContent = expanded ? '收起 ↑' : '展开 ↗'; document.body.classList.toggle('player-full-open', expanded); inlineFull.hidden = !expanded; });
        inlinePlay.addEventListener('click', () => { if (!howl) return load(index, true); if (howl.playing()) howl.pause(); else { howl.play(); setPlaying(true); } }); inlinePrev.addEventListener('click', () => load((index - 1 + queue.length) % queue.length, true)); inlineNext.addEventListener('click', () => load((index + 1) % queue.length, true)); inlineLoop.addEventListener('change', (event) => { root.querySelector('[data-global-loop]').checked = event.target.checked; if (howl) howl.loop(event.target.checked); }); inlineSeek.addEventListener('input', () => { if (howl && howl.duration()) { howl.seek((Number(inlineSeek.value) / 100) * howl.duration()); update(); } }); root.querySelector('[data-full-close]').addEventListener('click', () => { root.classList.remove('is-full'); inlineFull.hidden = true; fullToggle.setAttribute('aria-expanded', 'false'); fullToggle.textContent = '展开 ↗'; document.body.classList.remove('player-full-open'); });
        window.addEventListener('songbook:track', (event) => { const track = event.detail; const nextMode = track.quality ? 'original' : 'cover'; setMode(nextMode, track); });
        buildQueue(); if (queue.length) load(0);
      }
    </script>
  </body>
</html>

<style>
  :global(:root) { --ink:#26202e; --muted:#827789; --line:#e8e0eb; --pink:#dc86b1; --pink-soft:#fff0f7; --plum:#30273b; --canvas:#fcfafc; }
  :global(*) { box-sizing:border-box; }
  :global(body) { margin:0; padding-bottom:86px; color:var(--ink); background:var(--canvas); font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
  :global(a) { color:inherit; text-decoration:none; }
  .site-shell { max-width:1160px; margin:auto; padding:0 38px; }
  .topbar { height:82px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line); }
  .brand { display:flex; align-items:center; gap:.65rem; }.brand-symbol { display:grid; place-items:center; width:29px; height:29px; border-radius:9px; color:#fff; background:var(--plum); font-size:.9rem; }.brand-name { display:flex; align-items:baseline; gap:.45rem; font-size:.85rem; font-weight:800; letter-spacing:.14em; }.brand-name small { color:#aaa0ae; font-size:.56rem; font-weight:600; letter-spacing:.16em; }.topbar-right { display:flex; align-items:center; gap:1.3rem; color:#a198a7; font-size:.63rem; letter-spacing:.12em; }.topbar-right a { color:var(--ink); font-size:.72rem; letter-spacing:0; }.live-dot { width:6px; height:6px; border-radius:50%; background:var(--pink); box-shadow:0 0 0 4px #dc86b11f; }
  .search-panel { display:grid; gap:1.35rem; padding:4.5rem 0 2.3rem; border-bottom:1px solid var(--line); }.search-heading { display:flex; align-items:end; justify-content:space-between; gap:2rem; }.search-heading h1 { margin:0 0 .55rem; font-family:Georgia,serif; font-size:clamp(2.8rem,6vw,5rem); font-weight:500; letter-spacing:-.07em; }.search-heading p:not(.kicker) { margin:0; color:var(--muted); font-size:.82rem; }.search-total { color:#aaa1ae; font-size:.62rem; letter-spacing:.15em; }.song-search { display:flex; align-items:center; gap:.7rem; width:min(680px,100%); padding:.85rem 1rem; border:1px solid var(--line); border-radius:10px; color:var(--muted); background:#fff; box-shadow:0 8px 25px #38243d0a; }.song-search:focus-within { border-color:#d891b5; box-shadow:0 0 0 3px #dc86b11a; }.song-search input { width:100%; border:0; outline:0; color:var(--ink); background:transparent; font:inherit; font-size:.78rem; }.song-search input::placeholder { color:#aaa1ae; }
